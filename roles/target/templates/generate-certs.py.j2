#!/usr/bin/env python3
import datetime
import ipaddress
import pathlib
import sys
from cryptography import x509
from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.x509.oid import NameOID

out = pathlib.Path(sys.argv[1])
out.mkdir(parents=True, exist_ok=True)
now = datetime.datetime.now(datetime.timezone.utc)

def key():
    return rsa.generate_private_key(public_exponent=65537, key_size=2048)

def name(cn):
    return x509.Name([x509.NameAttribute(NameOID.ORGANIZATION_NAME, "SOC Lab"), x509.NameAttribute(NameOID.COMMON_NAME, cn)])

def write_key(path, private_key):
    path.write_bytes(private_key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.TraditionalOpenSSL, serialization.NoEncryption()))
    path.chmod(0o600)

ca_key = key()
ca_name = name("SOC Lab Root CA")
ca_cert = (x509.CertificateBuilder().subject_name(ca_name).issuer_name(ca_name).public_key(ca_key.public_key())
           .serial_number(x509.random_serial_number()).not_valid_before(now - datetime.timedelta(days=1))
           .not_valid_after(now + datetime.timedelta(days=3650)).add_extension(x509.BasicConstraints(ca=True, path_length=None), critical=True)
           .sign(ca_key, hashes.SHA256()))
write_key(out / "ca.key", ca_key)
(out / "ca.crt").write_bytes(ca_cert.public_bytes(serialization.Encoding.PEM))

def signed(label, cn, before, after, issuer_key=ca_key, issuer_name=ca_name):
    private_key = key()
    cert = (x509.CertificateBuilder().subject_name(name(cn)).issuer_name(issuer_name).public_key(private_key.public_key())
            .serial_number(x509.random_serial_number()).not_valid_before(before).not_valid_after(after)
            .add_extension(x509.SubjectAlternativeName([x509.DNSName(cn), x509.IPAddress(ipaddress.ip_address("10.20.20.20"))]), critical=False)
            .sign(issuer_key, hashes.SHA256()))
    write_key(out / f"{label}.key", private_key)
    (out / f"{label}.crt").write_bytes(cert.public_bytes(serialization.Encoding.PEM))

signed("valid", "valid.soc.test", now - datetime.timedelta(days=1), now + datetime.timedelta(days=365))
signed("expired", "expired.soc.test", now - datetime.timedelta(days=365), now - datetime.timedelta(days=1))
rogue_key = key()
rogue_name = name("rogue.soc.test")
rogue_cert = (x509.CertificateBuilder().subject_name(rogue_name).issuer_name(rogue_name).public_key(rogue_key.public_key())
              .serial_number(x509.random_serial_number()).not_valid_before(now - datetime.timedelta(days=1))
              .not_valid_after(now + datetime.timedelta(days=365)).add_extension(x509.BasicConstraints(ca=False, path_length=None), critical=True)
              .sign(rogue_key, hashes.SHA256()))
write_key(out / "rogue.key", rogue_key)
(out / "rogue.crt").write_bytes(rogue_cert.public_bytes(serialization.Encoding.PEM))

