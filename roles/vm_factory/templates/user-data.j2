#cloud-config
hostname: {{ item.name }}
manage_etc_hosts: true
users:
  - name: {{ soc_admin_user }}
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - {{ soc_ssh_public_key }}
ssh_pwauth: false
disable_root: true
package_update: false
packages:
  - qemu-guest-agent
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]

